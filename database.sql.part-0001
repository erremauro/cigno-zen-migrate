(3984,682,'rank_math_title','Lemma: %term% %sep% Dizionario Buddhista | %sitename%'),
(3985,682,'rank_math_description','Maitreya. In sanscrito, \"Colui che è benevolo\"; nome del prossimo buddha, che ora dimora nel cielo tuṣita come bodhisattva, in attesa del momento propizio per la sua ultima rinascita.'),
(3986,682,'rank_math_focus_keyword','Maitreya'),
