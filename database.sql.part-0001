(4618,720,'rank_math_seo_score','100'),
(4619,720,'rank_math_focus_keyword','Yāma'),
(4620,720,'rank_math_description','Yāma. In sanscrito e pāli, nome proprio di un cielo del regno del desiderio (kāmadhātu); noto anche come suyāma (\"dove le stagioni sono sempre favorevoli\").'),
(4621,720,'show_as',''),
