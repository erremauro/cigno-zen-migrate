(1518,204,'_show_as','field_68bac52494ccb'),
(1519,204,'synonyms_csv','Indra'),
(1520,204,'_synonyms_csv','field_68a047395f157'),
(1521,204,'readings','Devangari: कौशिक; Sanscrito: kauśika; Pāli: kosiya; Tibetano: ka’u shi ka (ཀའུ་ཤི་ཀ); Cinese: 憍尸迦 (jiaoshijia); Giapponese: 憍尸迦 (kyōshika); Coreano: 교시가 (kyosiga)'),
(1522,204,'_readings','field_68a047245f156'),
(1523,204,'short_definition','<p>Nome con cui viene indicato il re del cielo dei Trentatré (<em><a href=\"/lemma/trayastrimsa\">trayastrims\'a</a></em>), <em><a href=\"/lemma/sakrodevanamindra\">sakro devanam indra</a></em> (più comunemente noto come <em><a href=\"/lemma/sakra\">sakra</a></em> o <em><a href=\"/lemma/indra\">indra</a></em>), durante una sua precedente esistenza umana come sacerdote brāhmaṇa. Nei testi buddhisti, Śakra è spesso chiamato in modo più familiare proprio con il nome Kauśika.</p>\r\n'),
(1524,204,'_short_definition','field_68a046da5f154'),
(1525,204,'description',''),
(1526,204,'_description','field_68a046f15f155'),
(1527,204,'definition_source','The Princeton Dictionary of Buddhism'),
(1528,204,'_definition_source','field_68a0aaf7cd3b1'),
(1529,205,'show_as','Indra'),
(1530,205,'_show_as','field_68bac52494ccb'),
(1531,205,'synonyms_csv','kauśika'),
(1532,205,'_synonyms_csv','field_68a047395f157'),
(1533,205,'readings','Devangari: इन्द्र; Sanscrito: indra; Pāli: inda; Tibetano: dbang po (དབང་པོ); Cinese: 因陀罗 / 帝释 (yintuoluo / di-shi); Giapponese: インダラ / 帝釈 (indara / taishaku); Coreano: 인다라 / 제석 (indara / che-sŏk)'),
(1534,205,'_readings','field_68a047245f156'),
(1535,205,'short_definition','<p>In sanscrito, <em>indra</em> è un\'abbreviazione di <em><a href=\"/lemma/sakrodevanamindra\">sakro devanam indrah</a></em> (\"<em><a href=\"/lemma/sakra\">sakra</a></em>, il re degli dèi\"). Indra è il re vedico delle divinità dell\'atmosfera o del cielo, che nella religione popolare indiana finisce per diventare il capo di tutte le divinità.</p>'),
(1536,205,'_short_definition','field_68a046da5f154'),
(1537,205,'description','<p>Nel buddhismo, Indra viene integrato nel pantheon come protettore del <em><a href=\"/lemma/dharma\">dharma</a></em> e come re del regno dei <em><a href=\"/lemma/deva\">deva</a></em>. Nell\'iconografia buddhista indiana Indra è sempre raffigurato in posizione subordinata rispetto al Buddha: lo venera, regge un ombrello sopra di lui per ripararlo dal sole, oppure porta per lui la ciotola delle elemosine.</p>\r\n\r\n<p>Indra presiede il cielo delle Trentatré divinità (<em><a href=\"/lemma/trayastrimsa\">trayastrims\'a</a></em>), il secondo dei sei reami celesti che esistono all\'interno del reame del desiderio (<em><a href=\"/lemma/kamadhatu\">kamadhatu</a></em>), situato sulla sommità del <em><a href=\"/lemma/monte-sumeru\">monte sumeru</a></em>. Al centro di questo cielo si trova la città reale di Indra, Sudarśana, nel cui punto centrale sorge il suo palazzo reale, Vaijayanta.</p>\r\n'),
(1538,205,'_description','field_68a046f15f155'),
(1539,205,'definition_source','The Princeton Dictionary of Buddhism'),
(1540,205,'_definition_source','field_68a0aaf7cd3b1'),
(1541,206,'show_as','bhagavat'),
