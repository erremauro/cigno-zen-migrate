(2931,357,'synonyms_csv',''),
(2932,357,'_synonyms_csv','field_68a047395f157'),
(2933,357,'readings','Devanagari: आस्रवक्षय; Sanscrito: āsravakṣaya; Pāli: āsavakkhaya; Tibetano: ཟག་པ་ཟད་པ (zag pa zad pa); Cinese: 漏盡智 (lòujìnzhì); Giapponese: 漏盡智 (rojinchi); Coreano: 누진지 (nujinji)'),
(2934,357,'_readings','field_68a047245f156'),
(2935,357,'short_definition','<p>In sanscrito, \"estinzione delle contaminazioni\"; un potere sovrannaturale (<em><a href=\"/lemma/abhijna\">abhijñā</a></em>) prodotto attraverso il perfezionamento della visione profonda (<em><a href=\"/lemma/vipasyana\">vipaśyanā</a></em>), e una delle tre conoscenze (<em><a href=\"/lemma/trividya\">trividyā</a></em>) che sono i frutti del risveglio (<em><a href=\"/lemma/bodhi\">bodhi</a></em>). Colui che raggiunge questo stato è un \"degno\" (<em><a href=\"/lemma/arhat\">arhat</a></em>) e alla morte entra nel <em><a href=\"/lemma/nirvana\">nirvāṇa</a></em>, per non rinascere mai più. Cfr. anche <em><a href=\"/lemma/anasrava\">anāsrava</a></em>; <em><a href=\"/lemma/asrava\">āsrava</a></em>.</p>'),
(2936,357,'_short_definition','field_68a046da5f154'),
