(420,15,'author_portrait','843'),
(421,15,'_author_portrait','field_689b464c824f4'),
(422,15,'author_birth','?'),
(423,15,'_author_birth','field_689b46a0824f7'),
(424,15,'author_death','606'),
(425,15,'_author_death','field_689b46af824f8'),
(426,15,'author_short_bio','Terzo patriarca del Buddhismo Zen, discepolo di Huìkě. Come per Bodhidharma e Huìkě la sua vita è avvolta nella leggenda. A lungo ritenuto l\'autore dello Xìnxīn míng, oggi sappiamo che il testo non può essere anteriore all\'VIII secolo.'),
(427,15,'_author_short_bio','field_689b4675824f5'),
(428,15,'author_full_bio',''),
(429,15,'_author_full_bio','field_689b468c824f6'),
